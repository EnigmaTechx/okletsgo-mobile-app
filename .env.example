# Copy to .env (git-ignored). Values starting with EXPO_PUBLIC_ are inlined
# into the JS bundle; the others are only read by app.config.ts at build time.

# Google Maps Platform key used from the app for Places Autocomplete,
# Geocoding and Distance Matrix (the same three the Ionic app's web key
# uses). Must NOT carry HTTP-referrer restrictions. See docs/PHASE2.md.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Maps SDK for Android key (restricted to com.enigmatech.rideshare + SHA-1).
# Optional: falls back to EXPO_PUBLIC_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_ANDROID_API_KEY=

# Firebase native config files (paths). Optional locally when the files sit
# in the project root.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
